# Per-client secrets for LOCAL builds.
#
# Copy this file to clients/<client>/.env (gitignored) and fill it in.
# On Codemagic the same names come from the client's environment variable group,
# and real environment variables always win over this file.

# Credentials the app uses to authenticate against the client's API.
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional: override values from config.json for this client only, e.g. to point
# a local build at a staging backend without committing the change.
# AUTH_APP_URL=https://staging.example.com/     (api.baseUrl)
# AUTH_APP_NAME=mobile_app_manager              (api.appName, the name in /api/<name>/...)
# ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
