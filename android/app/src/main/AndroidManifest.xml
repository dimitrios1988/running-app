<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Required for notifications on Android 13+ (API 33). OneSignal's manifest
         merge normally supplies this, but targetSdk is 36 so we declare it
         explicitly rather than depend on the merge. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The selfie screen uses getUserMedia() in the WebView; Capacitor's
         BridgeWebChromeClient turns that into a runtime CAMERA request, which
         needs this declaration. It currently also arrives via a transitive dep
         of @capacitor/inappbrowser - declaring it here means the camera does not
         silently break if that dep is ever removed or bumped. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Declaring CAMERA implies uses-feature camera required=true, which would
         filter camera-less devices on Play. The selfie is optional, so opt out. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
